# Backend API Configuration
BACKEND_PORT=8000
FLASK_APP=main.py # Or your FastAPI app entry point, e.g., main:app
FLASK_ENV=development # or production
# For FastAPI, you might use variables like APP_MODULE="main:app"

# Frontend Configuration (primarily for local dev if frontend run outside Docker)
# Inside Docker, API_BASE_URL is set in docker-compose.yml for the frontend service
# VITE_API_BASE_URL=http://localhost:8000 

# Database (SQLite - path configured in backend code, no separate env vars needed here)

# If using PostgreSQL (example, not default for this relic)
# DB_HOST=chimeradash_db
# DB_PORT=5432
# DB_USER=relicuser
# DB_PASS=relicpassword
# DB_NAME=relicdb

# Other application specific variables
# SECRET_KEY=your_very_secret_key
