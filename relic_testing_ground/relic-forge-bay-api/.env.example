FORGE_API_HOST=0.0.0.0
# This port is for the client.sh to target the host machine's exposed port.
# It should match the host port in docker-compose.yml's port mapping.
# The docker-compose.yml uses ${FORGE_API_PORT:-13080}:8000, so 13080 is the default host port if FORGE_API_PORT is not set for compose.
FORGE_API_PORT=13080

# Internal container port for Uvicorn (usually fixed, like 8000)
# APP_INTERNAL_PORT=8000 # Not directly used by client.sh, but good for reference

FORGE_DATABASE_URL=sqlite+aiosqlite:///./storage/forge_db/relics.db
FORGED_RELICS_DIR=./storage/forged_relics
LOG_LEVEL=INFO
RELIC_FORGE_VERSION=0.1.2
RELIC_FORGE_SERVICE_NAME=RelicForgeBayAPI
