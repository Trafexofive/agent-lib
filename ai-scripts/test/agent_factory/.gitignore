pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.hypothesis/

# Environments
.env
.venv
venv/
ENV/
env/

# Docker
.dockerignore

